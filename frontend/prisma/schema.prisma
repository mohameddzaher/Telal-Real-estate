generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  AGENT
  ANALYST
  CONTENT_EDITOR
  CLIENT
  GUEST
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  MIXED_USE
  OFF_PLAN
  RETAIL
  HOSPITALITY
}

enum PropertyStatus {
  AVAILABLE
  SOLD
  OFF_PLAN
  UNDER_CONSTRUCTION
  RESERVED
}

enum ProjectStatus {
  PLANNING
  UNDER_CONSTRUCTION
  COMPLETED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  NEGOTIATING
  CLOSED_WON
  CLOSED_LOST
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String?
  phone         String?
  role          UserRole  @default(CLIENT)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bookings      Booking[]
  favorites     PropertyFavorite[]
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Property {
  id            String             @id @default(cuid())
  slug          String             @unique
  title         String
  titleAr       String
  description   String             @db.Text
  descriptionAr String             @db.Text
  type          PropertyType
  status        PropertyStatus
  price         Float
  currency      String             @default("SAR")
  area          Float
  bedrooms      Int?
  bathrooms     Int?
  floors        Int?
  parkingSpots  Int?
  location      String
  city          String
  coordinates   Json?
  amenities     String[]
  images        PropertyImage[]
  videos        String[]
  floorPlans    String[]
  projectId     String?
  project       Project?           @relation(fields: [projectId], references: [id])
  isFeatured    Boolean            @default(false)
  isPublished   Boolean            @default(false)
  views         Int                @default(0)
  favorites     PropertyFavorite[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model PropertyImage {
  id         String   @id @default(cuid())
  url        String
  alt        String
  order      Int      @default(0)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model PropertyFavorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
}

model Project {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  nameAr         String
  description    String        @db.Text
  type           String
  status         ProjectStatus
  location       String
  launchDate     DateTime?
  completionDate DateTime?
  totalUnits     Int?
  masterPlan     String?
  coverImage     String
  gallery        String[]
  properties     Property[]
  isPublished    Boolean       @default(false)
  isFeatured     Boolean       @default(false)
  createdAt      DateTime      @default(now())
}

model MeetingRoom {
  id        String    @id @default(cuid())
  name      String
  capacity  Int
  amenities String[]
  imageUrl  String?
  floor     Int?
  isActive  Boolean   @default(true)
  bookings  Booking[]
}

model Booking {
  id           String        @id @default(cuid())
  referenceNo  String        @unique @default(cuid())
  roomId       String
  room         MeetingRoom   @relation(fields: [roomId], references: [id])
  userId       String?
  user         User?         @relation(fields: [userId], references: [id])
  guestName    String
  guestEmail   String
  guestPhone   String
  company      String?
  purpose      String
  date         DateTime
  startTime    String
  endTime      String
  attendees    Int           @default(1)
  notes        String?
  status       BookingStatus @default(PENDING)
  cancelReason String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Lead {
  id         String     @id @default(cuid())
  name       String
  email      String
  phone      String?
  company    String?
  message    String     @db.Text
  source     String?
  status     LeadStatus @default(NEW)
  assignedTo String?
  notes      LeadNote[]
  propertyId String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model LeadNote {
  id        String   @id @default(cuid())
  content   String   @db.Text
  authorId  String
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  isConfirmed Boolean  @default(false)
  token       String?
  createdAt   DateTime @default(now())
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  titleAr     String
  excerpt     String    @db.Text
  body        String    @db.Text
  coverImage  String
  category    String
  tags        String[]
  author      String
  readTime    Int
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
}

model FAQ {
  id          String  @id @default(cuid())
  question    String
  questionAr  String
  answer      String  @db.Text
  answerAr    String  @db.Text
  category    String
  order       Int     @default(0)
  isPublished Boolean @default(true)
}

model Testimonial {
  id          String  @id @default(cuid())
  clientName  String
  clientTitle String?
  content     String  @db.Text
  contentAr   String? @db.Text
  rating      Int     @default(5)
  propertyId  String?
  avatar      String?
  isPublished Boolean @default(true)
  order       Int     @default(0)
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  userAgent String?
  country   String?
  city      String?
  device    String?
  browser   String?
  sessionId String?
  createdAt DateTime @default(now())
}
