generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String    @unique
  password      String?
  phone         String?
  role          String    @default("CLIENT")
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bookings      Booking[]
  favorites     PropertyFavorite[]
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Property {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  slug          String             @unique
  title         String
  titleAr       String
  description   String
  descriptionAr String
  type          String
  status        String
  price         Float
  currency      String             @default("SAR")
  area          Float
  bedrooms      Int?
  bathrooms     Int?
  floors        Int?
  parkingSpots  Int?
  location      String
  city          String
  coordinates   Json?
  amenities     String[]
  images        PropertyImage[]
  videos        String[]
  floorPlans    String[]
  projectId     String?            @db.ObjectId
  project       Project?           @relation(fields: [projectId], references: [id])
  isFeatured    Boolean            @default(false)
  isPublished   Boolean            @default(false)
  views         Int                @default(0)
  favorites     PropertyFavorite[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model PropertyImage {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  url        String
  alt        String
  order      Int      @default(0)
  propertyId String   @db.ObjectId
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model PropertyFavorite {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  propertyId String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
}

model Project {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  slug           String        @unique
  name           String
  nameAr         String
  description    String
  type           String
  status         String
  location       String
  launchDate     DateTime?
  completionDate DateTime?
  totalUnits     Int?
  masterPlan     String?
  coverImage     String
  gallery        String[]
  properties     Property[]
  isPublished    Boolean       @default(false)
  isFeatured     Boolean       @default(false)
  createdAt      DateTime      @default(now())
}

model MeetingRoom {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  capacity  Int
  amenities String[]
  imageUrl  String?
  floor     Int?
  isActive  Boolean   @default(true)
  bookings  Booking[]
}

model Booking {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  referenceNo  String      @unique
  roomId       String      @db.ObjectId
  room         MeetingRoom @relation(fields: [roomId], references: [id])
  userId       String?     @db.ObjectId
  user         User?       @relation(fields: [userId], references: [id])
  guestName    String
  guestEmail   String
  guestPhone   String
  company      String?
  purpose      String
  date         DateTime
  startTime    String
  endTime      String
  attendees    Int         @default(1)
  notes        String?
  status       String      @default("PENDING")
  cancelReason String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Lead {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  email      String
  phone      String?
  company    String?
  message    String
  source     String?
  status     String     @default("NEW")
  assignedTo String?    @db.ObjectId
  notes      LeadNote[]
  propertyId String?    @db.ObjectId
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model LeadNote {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  authorId  String   @db.ObjectId
  leadId    String   @db.ObjectId
  lead      Lead     @relation(fields: [leadId], references: [id])
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  email       String   @unique
  isConfirmed Boolean  @default(false)
  token       String?
  createdAt   DateTime @default(now())
}

model BlogPost {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  slug        String    @unique
  title       String
  titleAr     String
  excerpt     String
  body        String
  coverImage  String
  category    String
  tags        String[]
  author      String
  readTime    Int
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
}

model FAQ {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  question    String
  questionAr  String
  answer      String
  answerAr    String
  category    String
  order       Int     @default(0)
  isPublished Boolean @default(true)
}

model Testimonial {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  clientName  String
  clientTitle String?
  content     String
  contentAr   String?
  rating      Int     @default(5)
  propertyId  String?
  avatar      String?
  isPublished Boolean @default(true)
  order       Int     @default(0)
}

model PageView {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  path      String
  referrer  String?
  userAgent String?
  country   String?
  city      String?
  device    String?
  browser   String?
  sessionId String?
  createdAt DateTime @default(now())
}
