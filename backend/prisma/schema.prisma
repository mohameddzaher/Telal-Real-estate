// Telal Development — Prisma Schema
// This schema mirrors the frontend types

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  AGENT
  ANALYST
  CONTENT_EDITOR
  CLIENT
  GUEST
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  MIXED_USE
  OFF_PLAN
  RETAIL
  HOSPITALITY
}

enum PropertyStatus {
  AVAILABLE
  SOLD
  OFF_PLAN
  UNDER_CONSTRUCTION
  RESERVED
}

enum ProjectStatus {
  PLANNING
  UNDER_CONSTRUCTION
  COMPLETED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  NEGOTIATING
  CLOSED_WON
  CLOSED_LOST
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  phone         String?
  password      String?
  role          UserRole  @default(CLIENT)
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bookings  Booking[]
  leads     Lead[]    @relation("AssignedLeads")
  leadNotes LeadNote[]
}

model Property {
  id            String         @id @default(cuid())
  slug          String         @unique
  title         String
  titleAr       String
  description   String
  descriptionAr String
  type          PropertyType
  status        PropertyStatus
  price         Float
  currency      String         @default("SAR")
  area          Float
  bedrooms      Int?
  bathrooms     Int?
  floors        Int?
  parkingSpots  Int?
  location      String
  city          String
  lat           Float?
  lng           Float?
  amenities     String[]
  videos        String[]
  floorPlans    String[]
  projectId     String?
  project       Project?       @relation(fields: [projectId], references: [id])
  isFeatured    Boolean        @default(false)
  isPublished   Boolean        @default(false)
  views         Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  images PropertyImage[]
  leads  Lead[]
}

model PropertyImage {
  id         String   @id @default(cuid())
  url        String
  alt        String
  order      Int      @default(0)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Project {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  nameAr         String
  description    String
  type           String
  status         ProjectStatus
  location       String
  launchDate     DateTime?
  completionDate DateTime?
  totalUnits     Int?
  masterPlan     String?
  coverImage     String        @default("")
  gallery        String[]
  isPublished    Boolean       @default(false)
  isFeatured     Boolean       @default(false)
  createdAt      DateTime      @default(now())

  properties Property[]
}

model MeetingRoom {
  id        String    @id @default(cuid())
  name      String
  capacity  Int
  amenities String[]
  imageUrl  String?
  floor     Int?
  isActive  Boolean   @default(true)

  bookings Booking[]
}

model Booking {
  id           String        @id @default(cuid())
  referenceNo  String        @unique
  roomId       String
  room         MeetingRoom   @relation(fields: [roomId], references: [id])
  userId       String?
  user         User?         @relation(fields: [userId], references: [id])
  guestName    String
  guestEmail   String
  guestPhone   String
  company      String?
  purpose      String
  date         DateTime
  startTime    String
  endTime      String
  attendees    Int
  notes        String?
  status       BookingStatus @default(PENDING)
  cancelReason String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Lead {
  id         String     @id @default(cuid())
  name       String
  email      String
  phone      String?
  company    String?
  message    String
  source     String?
  status     LeadStatus @default(NEW)
  assignedTo String?
  assignee   User?      @relation("AssignedLeads", fields: [assignedTo], references: [id])
  propertyId String?
  property   Property?  @relation(fields: [propertyId], references: [id])
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  notes LeadNote[]
}

model LeadNote {
  id        String   @id @default(cuid())
  content   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  isConfirmed Boolean  @default(false)
  token       String?
  createdAt   DateTime @default(now())
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  titleAr     String
  excerpt     String
  body        String
  coverImage  String
  category    String
  tags        String[]
  author      String
  readTime    Int
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
}

model FAQ {
  id          String  @id @default(cuid())
  question    String
  questionAr  String
  answer      String
  answerAr    String
  category    String
  order       Int     @default(0)
  isPublished Boolean @default(true)
}

model Testimonial {
  id          String  @id @default(cuid())
  clientName  String
  clientTitle String?
  content     String
  contentAr   String?
  rating      Int
  propertyId  String?
  avatar      String?
  isPublished Boolean @default(true)
  order       Int     @default(0)
}

model PageView {
  id        String   @id @default(cuid())
  page      String
  referrer  String?
  userAgent String?
  sessionId String?
  timestamp DateTime @default(now())
}
